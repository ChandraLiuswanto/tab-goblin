{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "paths": { "@tab-goblin/protocol": ["../packages/protocol/src/index.ts"] },
    "lib": ["ES2023", "DOM"],
    "types": ["react"],
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true
  },
  "include": ["client/**/*.ts", "client/**/*.tsx", "index.client.tsx", "shared/**/*.ts"],
  "exclude": ["server", "index.server.ts", "test"]
}
